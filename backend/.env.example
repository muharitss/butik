# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Security & Rate Limiting
# Max mutating requests (POST/PATCH/PUT/DELETE) per IP per window
RATE_LIMIT_MAX_WRITES=120
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Authentication & Session
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-for-jahitflow-boutique
INITIAL_ADMIN_EMAIL=operator@jahitflow.com
INITIAL_ADMIN_PASSWORD=OperatorPass123!
SESSION_TTL_MS=3600000

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/jahitflow?schema=public"

# Cloudinary Configuration
# Provide either CLOUDINARY_URL or the individual parameters:
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@screenshottugas
CLOUDINARY_CLOUD_NAME=screenshottugas
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=jahitflow
