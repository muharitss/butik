datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String?
  role      String   @default("owner")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  measurementVersions MeasurementVersion[]

  @@map("users")
}

model Customer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz
  measurementVersions MeasurementVersion[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model GarmentType {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    @unique
  description       String?
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?                 @map("deleted_at") @db.Timestamptz
  measurementFields GarmentMeasurementField[]

  @@map("garment_types")
}

model GarmentMeasurementField {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  garmentTypeId String      @map("garment_type_id") @db.Uuid
  fieldKey      String      @map("field_key")
  label         String
  unit          String
  isRequired    Boolean     @default(true) @map("is_required")
  sortOrder     Int         @default(0) @map("sort_order")

  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)

  @@unique([garmentTypeId, fieldKey])
  @@index([garmentTypeId])
  @@map("garment_measurement_fields")
}

model MeasurementVersion {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  versionNumber Int                @map("version_number")
  label         String?
  notes         String?
  measuredAt    DateTime           @map("measured_at") @db.Timestamptz
  createdBy     String?            @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user          User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  values        MeasurementValue[]

  @@unique([customerId, versionNumber])
  @@index([customerId])
  @@map("measurement_versions")
}

model MeasurementValue {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  measurementVersionId String             @map("measurement_version_id") @db.Uuid
  fieldKey             String             @map("field_key")
  value                Decimal            @db.Decimal(6, 2)
  unit                 String

  measurementVersion   MeasurementVersion @relation(fields: [measurementVersionId], references: [id], onDelete: Cascade)

  @@unique([measurementVersionId, fieldKey])
  @@index([measurementVersionId])
  @@map("measurement_values")
}
